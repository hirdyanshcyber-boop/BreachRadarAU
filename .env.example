# AWS
AWS_ACCESS_KEY_ID=your_key
AWS_SECRET_ACCESS_KEY=your_secret
AWS_REGION=ap-southeast-2

# DynamoDB tables
DYNAMO_EVENTS_TABLE=breach_events
DYNAMO_OAIC_TABLE=oaic_stats
DYNAMO_VENDORS_TABLE=vendor_watchlist

# Google AI (Gemma 4)
GOOGLE_AI_API_KEY=your_google_ai_key
GEMMA_MODEL=gemma-4-27b-it

# SNS
SNS_ALERT_TOPIC_ARN=arn:aws:sns:ap-southeast-2:ACCOUNT_ID:breach-alerts

# HIBP (optional - free tier has rate limits)
HIBP_API_KEY=your_hibp_key

# Collector schedule (minutes)
POLL_INTERVAL_MINUTES=15
